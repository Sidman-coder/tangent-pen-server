# Shared secret the pen firmware sends in the X-Pen-Key header.
# Generate a key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real value. On Railway, set it in the Variables tab.
PEN_KEY=PASTE_YOUR_GENERATED_KEY_HERE

# Deepgram API key for transcription (from console.deepgram.com -> API Keys).
# Optional: without it the server still accepts uploads but skips transcription.
DEEPGRAM_API_KEY=PASTE_YOUR_DEEPGRAM_KEY_HERE
